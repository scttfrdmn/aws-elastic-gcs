# Copy to bench.env (gitignored) and fill in for your src/dst deployment pair.
# IDs and names only: no secrets go in this file. Globus client secrets stay in
# Secrets Manager and are read on the control nodes inside each SSM command.
REGION=us-west-2
SRC_CONTROL=i-xxxxxxxxxxxxxxxxx   # ElasticGCS-Control-<region>-src ControlNodeInstanceId
DST_CONTROL=i-xxxxxxxxxxxxxxxxx   # ElasticGCS-Control-<region>-dst ControlNodeInstanceId
SRC_COL=00000000-0000-0000-0000-000000000000   # src mapped collection (RODA gateway)
DST_COL=00000000-0000-0000-0000-000000000000   # dst mapped collection (bench bucket)

# Envelope study (#151); see README.md "Prerequisites". Used by study.py and synth.py.
SYNTH_BUCKET=elastic-gcs-envelope-synth-xxxx   # private bucket with the synthetic datasets (src reads it)
SRC_SYNTH_COL=00000000-0000-0000-0000-000000000000   # src mapped collection on SYNTH_BUCKET (credentialed S3 gateway)
DST_BENCH_BUCKET=elastic-gcs-bench-xxxx       # private bucket behind DST_COL (transfers write here)
SRC_POSIX_COL=00000000-0000-0000-0000-000000000000   # src POSIX collection on the src DTN's gp3 volume
DST_POSIX_COL=00000000-0000-0000-0000-000000000000   # dst POSIX collection on the dst DTN's gp3 volume
SRC_POSIX_BASE=/data          # collection path of the src POSIX root (synth.py --root on the src DTN)
DST_POSIX_BASE=/data          # collection path of the dst POSIX root
DST_POSIX_FS=/data            # the same root as a filesystem path on the dst DTN (for cleanup)
# Optional: endpoint FQDNs for the DNS readiness gate (discovered with `endpoint show` if unset)
SRC_ENDPOINT_FQDN=
DST_ENDPOINT_FQDN=
# S3 server access logs for P1b (logging must be enabled on both buckets beforehand)
S3_LOG_BUCKET=elastic-gcs-envelope-logs-xxxx
S3_LOG_PREFIX=access/
