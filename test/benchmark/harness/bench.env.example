# Copy to bench.env (gitignored) and fill in for your src/dst deployment pair.
REGION=us-west-2
SRC_CONTROL=i-xxxxxxxxxxxxxxxxx   # ElasticGCS-Control-<region>-src ControlNodeInstanceId
DST_CONTROL=i-xxxxxxxxxxxxxxxxx   # ElasticGCS-Control-<region>-dst ControlNodeInstanceId
SRC_COL=00000000-0000-0000-0000-000000000000   # src mapped collection (RODA gateway)
DST_COL=00000000-0000-0000-0000-000000000000   # dst mapped collection (bench bucket)
